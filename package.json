{
  "name": "jet-workshop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/physics && tsc -p packages/validation && tsc -p apps/web",
    "lint": "oxlint --deny-warnings packages apps",
    "validate": "tsx packages/validation/src/cli.ts",
    "dev": "pnpm --filter @jet-workshop/web dev",
    "check:browser": "node apps/web/scripts/audit.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
